# Copy to .env (which git ignores) and fill in locally. Never commit real values.
# EXPO_PUBLIC_ values are compiled into the app bundle: use them for local testing only.

# Kroger Products API (developer.kroger.com)
# EXPO_PUBLIC_KROGER_CLIENT_ID=
# EXPO_PUBLIC_KROGER_CLIENT_SECRET=

# Remote retailer rules (HTTPS, authenticated). Falls back to the bundled rules when unset.
# EXPO_PUBLIC_RETAILER_CONFIG_URL=

# Endpoint that receives search health events. Logs to the console only when unset.
# EXPO_PUBLIC_TELEMETRY_URL=

# Browser Use (cloud fetch: Walmart and Target through its cloud browsers; see the README). Compiled into the app bundle
# like every EXPO_PUBLIC_ value: anyone with the build can read it. Local testing only.
# EXPO_PUBLIC_BROWSER_USE_API_KEY=
